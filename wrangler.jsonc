{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "admin",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "admin" }],
  "images": {
   "binding": "IMAGES",
  },
   "vars": {
    "NEXT_PUBLIC_API_URL": "https://backend-wvhl.onrender.com/api",
    "NEXT_PUBLIC_SITE_NAME": "Western Insider Resources",
    "NEXT_PUBLIC_SITE_URL":"https://client.devvictor204.workers.dev"
  },
}